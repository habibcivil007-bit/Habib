<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RooMNRooF CAD PRO ULTIMATE - AutoCAD 2027 plugin.
    AutoCAD 2027 managed API assemblies are referenced from the local AutoCAD installation
    (Copy Local = false). Override with:  msbuild /p:AcadDir="D:\Autodesk\AutoCAD 2027"
    The shared plugin source lives in ..\Shared\RooMNRooF.Plugin and is compiled per version
    so that version-specific references stay separate.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>RooMNRooF.CAD</AssemblyName>
    <RootNamespace>RooMNRooF.Plugin</RootNamespace>
    <DefineConstants>$(DefineConstants);ACAD2027</DefineConstants>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AcadDir Condition="'$(AcadDir)'==''">C:\Program Files\Autodesk\AutoCAD 2027</AcadDir>
    <AcadRelease>R26.0</AcadRelease>
    <OutputPath>..\..\Build\bin\AutoCAD2027\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="..\..\Build\Version.props" />
  <ItemGroup>
    <Compile Include="..\Shared\RooMNRooF.Plugin\**\*.cs" LinkBase="Plugin" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\RooMNRooF.Core\RooMNRooF.Core.csproj" />
  </ItemGroup>
  <!-- Local AutoCAD install is preferred; otherwise (CI / no AutoCAD) the official Autodesk
       "AutoCAD.NET" NuGet reference assemblies are used. Runtime assets are never copied. -->
  <PropertyGroup>
    <UseAcadNuGet Condition="'$(UseAcadNuGet)'=='' And !Exists('$(AcadDir)\acdbmgd.dll')">true</UseAcadNuGet>
    <AcadNuGetVersion Condition="'$(AcadNuGetVersion)'==''">26.0.*</AcadNuGetVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseAcadNuGet)'!='true'">
    <Reference Include="AcCoreMgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseAcadNuGet)'=='true'">
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNuGetVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
