<?xml version="1.0" encoding="utf-8"?>
<!--
  RooMNRooF CAD PRO ULTIMATE - Autodesk ApplicationPlugins bundle manifest.
  Installed to %ProgramData%\Autodesk\ApplicationPlugins\RooMNRooF.bundle (per-machine) by the MSI,
  or copied manually. No registry entries are written. AutoCAD loads the DLL for the matching
  release (SeriesMin/SeriesMax) on startup; LISP is loaded on document open.
  Release series: AutoCAD 2026 = R25.1, AutoCAD 2027 = R26.0 (verify the 2027 series number
  against the installed product's ACADVER before release - see Documentation/06_Build_And_Release.md).
-->
<ApplicationPackage SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    Name="RooMNRooF CAD PRO ULTIMATE"
    Description="2D architectural and RCC structural drafting standards suite (drafting tool - not an engineering design or code-compliance tool)."
    AppVersion="2.0.0"
    FriendlyVersion="2.0.0"
    ProductType="Application"
    SupportedLocales="Enu"
    AppNameSpace="com.roomnroof.cadpro"
    Author="RooMNRooF"
    ProductCode="{6E1B3F2A-8C4D-4B7A-9E21-5A0C7D3F9B10}"
    UpgradeCode="{2F9D0C61-7B3E-4A5F-8D12-C4E6A9B1F073}"
    HelpFile="./Contents/Documentation/README.html">
  <CompanyDetails Name="RooMNRooF" Url="" Email="" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R26.0" />
  <Components Description="AutoCAD 2026">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R25.1" />
    <ComponentEntry AppName="RooMNRooF.CAD.2026" Version="2.0.0" ModuleName="./Contents/Win64/2026/RooMNRooF.CAD.dll"
        AppDescription="RooMNRooF managed plugin for AutoCAD 2026" LoadOnAutoCADStartup="True" />
  </Components>
  <Components Description="AutoCAD 2027">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry AppName="RooMNRooF.CAD.2027" Version="2.0.0" ModuleName="./Contents/Win64/2027/RooMNRooF.CAD.dll"
        AppDescription="RooMNRooF managed plugin for AutoCAD 2027" LoadOnAutoCADStartup="True" />
  </Components>
  <Components Description="AutoLISP (all versions)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R26.0" />
    <ComponentEntry AppName="RooMNRooF.LISP" Version="2.0.0" ModuleName="./Contents/AutoLISP/RNR_Load.lsp"
        AppDescription="RooMNRooF RNRL-* AutoLISP commands" LoadOnAutoCADStartup="False" PerDocument="True" />
  </Components>
  <Components Description="Support paths">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R26.0" SupportPath="./Contents/Hatch;./Contents/Standards;./Contents/AutoLISP" />
  </Components>
</ApplicationPackage>
